# FacturaSolwed — Variables de entorno
# Copia a .env y ajusta los valores antes del primer arrange

# Puerto expuesto en el host
APP_PORT=80

# Base de datos
DB_NAME=facturascripts
DB_USER=fs_user
DB_PASS=cambia_esta_password_segura

# FacturaScripts
FS_LANG=es_ES
FS_TIMEZONE=Europe/Madrid
FS_API_KEY=genera_una_clave_aleatoria_larga

# SOLWED — Licencia y telemetría (opcional)
# Proporciona el SOLWED_LICENSE_KEY para activar soporte y actualizaciones gestionadas
SOLWED_LICENSE_KEY=
SOLWED_TELEMETRY_URL=https://mind.solwed.es/api/erp-telemetry
