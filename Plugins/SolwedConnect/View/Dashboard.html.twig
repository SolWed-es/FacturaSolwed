{% extends "@Core/Dashboard.html.twig" %}

{% block sectionLinks %}
    {{ parent() }}

    {% if fsc.mindNotifications is defined and fsc.mindNotifications|length > 0 %}
        <div class="col-12 mt-3" id="mind-notifications">
            {% for notif in fsc.mindNotifications %}
                {% set alertClass = 'alert-info' %}
                {% if notif.tipo == 'warning' %}{% set alertClass = 'alert-warning' %}{% endif %}
                {% if notif.tipo == 'critical' %}{% set alertClass = 'alert-danger' %}{% endif %}
                {% if notif.tipo == 'success' %}{% set alertClass = 'alert-success' %}{% endif %}
                <div class="alert {{ alertClass }} d-flex align-items-start mb-2" role="alert">
                    <div class="flex-grow-1">
                        <strong>{{ notif.titulo }}</strong>
                        <span class="ms-2">{{ notif.mensaje }}</span>
                    </div>
                </div>
            {% endfor %}
            <div class="text-end mb-2">
                <a href="{{ fsc.url() }}?action=dismiss-notifications"
                   class="btn btn-sm btn-outline-secondary">
                    Marcar como leídas
                </a>
            </div>
        </div>
    {% endif %}

    {% if fsc.licenseStatus is defined and not fsc.licenseStatus.managed|default(false) %}
        <div class="col-12 mt-3">
            <div class="card border-0 bg-light">
                <div class="card-body py-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-muted">Suscripción Solwed</small>
                            {% if fsc.licenseStatus.active|default(false) %}
                                <span class="badge bg-success ms-2">Activa</span>
                                <small class="text-muted ms-2">{{ fsc.licenseStatus.plan|default('') }}</small>
                            {% else %}
                                <span class="badge bg-danger ms-2">Inactiva</span>
                            {% endif %}
                        </div>
                        {% if fsc.licenseStatus.active|default(false) %}
                            <a href="{{ fsc.url() }}?action=revoke-license&multireqtoken={{ fsc.multiRequestProtection.newToken() }}"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('¿Quitar la licencia de esta instalación?')">
                                Quitar licencia
                            </a>
                        {% endif %}
                    </div>

                    {% if not fsc.licenseStatus.active|default(false) %}
                        <form method="post" action="{{ fsc.url() }}" class="mt-3">
                            <input type="hidden" name="action" value="activate-license">
                            <input type="hidden" name="multireqtoken" value="{{ fsc.multiRequestProtection.newToken() }}">
                            <div class="input-group input-group-sm">
                                <input type="text" name="license_code" class="form-control"
                                       placeholder="Código de activación (desde app.solwed.es)"
                                       autocomplete="off" required>
                                <button type="submit" class="btn btn-primary">
                                    Activar licencia
                                </button>
                                <a href="https://app.solwed.es/servicios/erp" target="_blank"
                                   class="btn btn-outline-secondary">
                                    Obtener código
                                </a>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
