{% extends "@Core/Dashboard.html.twig" %}

{% block sectionLinks %}
    {{ parent() }}

    {% if fsc.mindNotifications is defined and fsc.mindNotifications|length > 0 %}
        <div class="col-12 mt-3" id="mind-notifications">
            {% for notif in fsc.mindNotifications %}
                {% set alertClass = 'alert-info' %}
                {% if notif.tipo == 'warning' %}{% set alertClass = 'alert-warning' %}{% endif %}
                {% if notif.tipo == 'critical' %}{% set alertClass = 'alert-danger' %}{% endif %}
                {% if notif.tipo == 'success' %}{% set alertClass = 'alert-success' %}{% endif %}
                <div class="alert {{ alertClass }} d-flex align-items-start mb-2" role="alert">
                    <div class="flex-grow-1">
                        <strong>{{ notif.titulo }}</strong>
                        <span class="ms-2">{{ notif.mensaje }}</span>
                    </div>
                </div>
            {% endfor %}
            <div class="text-end mb-2">
                <a href="{{ fsc.url() }}?action=dismiss-notifications"
                   class="btn btn-sm btn-outline-secondary">
                    {{ trans('solwedconnect-mark-read') }}
                </a>
            </div>
        </div>
    {% endif %}

    {% if fsc.licenseStatus is defined and not fsc.licenseStatus.managed|default(false) %}
        <div class="col-12 mt-3">
            <div class="card border-0 bg-light">
                <div class="card-body py-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-muted">{{ trans('solwedconnect-subscription') }}</small>
                            {% if fsc.licenseStatus.active|default(false) %}
                                {% if fsc.licenseStatus.offline|default(false) %}
                                    <span class="badge bg-warning text-dark ms-2">
                                        <i class="fa-solid fa-wifi-slash fa-xs me-1"></i>{{ trans('solwedconnect-status-offline') }}
                                    </span>
                                {% elseif fsc.licenseStatus.grace|default(false) %}
                                    <span class="badge bg-warning text-dark ms-2">{{ trans('solwedconnect-status-grace') }}</span>
                                {% else %}
                                    <span class="badge bg-success ms-2">{{ trans('solwedconnect-status-active') }}</span>
                                {% endif %}
                                <small class="text-muted ms-2">{{ fsc.licenseStatus.plan|default('') }}</small>
                            {% else %}
                                <span class="badge bg-danger ms-2">{{ trans('solwedconnect-status-inactive') }}</span>
                            {% endif %}
                        </div>
                        {% if fsc.licenseStatus.active|default(false) %}
                            <a href="{{ fsc.url() }}?action=revoke-license&multireqtoken={{ fsc.multiRequestProtection.newToken() }}"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('{{ trans('solwedconnect-revoke-confirm') }}')">
                                {{ trans('solwedconnect-revoke-license') }}
                            </a>
                        {% endif %}
                    </div>

                    {% if not fsc.licenseStatus.active|default(false) %}
                        <form method="post" action="{{ fsc.url() }}" class="mt-3">
                            <input type="hidden" name="action" value="activate-license">
                            <input type="hidden" name="multireqtoken" value="{{ fsc.multiRequestProtection.newToken() }}">
                            <div class="input-group input-group-sm">
                                <input type="text" name="license_code" class="form-control"
                                       placeholder="{{ trans('solwedconnect-activation-code-placeholder') }}"
                                       autocomplete="off" required>
                                <button type="submit" class="btn btn-primary">
                                    {{ trans('solwedconnect-activate-license') }}
                                </button>
                                <a href="https://app.solwed.es/servicios/erp" target="_blank"
                                   class="btn btn-outline-secondary">
                                    {{ trans('solwedconnect-get-code') }}
                                </a>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
